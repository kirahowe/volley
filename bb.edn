{:paths ["src"]
 :deps {}
 :tasks
 {test {:doc "Run brisk's own test suite with brisk (tests.edn); takes brisk's flags"
        :extra-paths ["test" "dev-resources"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
        :requires ([brisk.main :as main])
        :task (System/exit (main/run *command-line-args*))}
  test:jvm {:doc "Run brisk's own test suite with the parent on the JVM (clojure -M:test); takes brisk's flags"
            :task (System/exit (:exit (apply shell {:continue true} "clojure" "-M:test" "-m" "brisk.main"
                                             *command-line-args*)))}
  test:bootstrap {:doc "Run brisk's own test suite with plain clojure.test"
                  :extra-paths ["test" "dev-resources"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
                  :requires ([brisk.test-bootstrap :as bootstrap])
                  :task (bootstrap/run-tests! *command-line-args*)}
  test:diff {:doc "Compare brisk's Kaocha-compat core against Kaocha itself (downloads Kaocha)"
             :extra-paths ["test" "dev-resources"]
             :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                          lambdaisland/kaocha {:mvn/version "1.91.1392"}}
             :requires ([brisk.test-bootstrap :as bootstrap])
             :task (bootstrap/run-tests! ["brisk.diff.kaocha-diff" "brisk.diff.kaocha-e2e"])}
  demo {:doc "Replay a scripted run through the live view (--ci, --speed N, --no-color)"
        :extra-paths ["dev"]
        :requires ([demo])
        :task (demo/-main *command-line-args*)}
  lint {:doc "Lint src and test with clj-kondo"
        :task (shell "clj-kondo --lint src test")}}}
