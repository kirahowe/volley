{:paths ["src"]
 ;; On babashka, edamame, babashka.fs and babashka.process are built in and
 ;; these entries are ignored. On the JVM they are real dependencies.
 :deps {borkdude/edamame {:mvn/version "1.6.42"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}}
 :aliases
 {:test {:extra-paths ["test" "dev-resources"]
         ;; data.xml parses junit-xml reports in the tests; babashka has it built in
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      org.clojure/data.xml {:mvn/version "0.0.8"}}}}}
